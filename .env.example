# ---------------------------------------------------------------------------
# Project Signal — environment configuration
#
# Copy to `.env.local` and edit. `.env.local` is gitignored.
# The application runs fully in demo mode with NO key and NO configuration.
# ---------------------------------------------------------------------------

# Which AI provider backs analysis and chat.
#   mock   — deterministic fixtures, zero network calls, zero tokens (DEFAULT)
#   gemini — real Google Gemini API calls (requires GEMINI_API_KEY below)
AI_PROVIDER=mock

# Google Gemini API key. Only read when AI_PROVIDER=gemini.
# Server-side only — never exposed to the browser.
# Leave empty here; put your real key in .env.local.
GEMINI_API_KEY=

# Gemini model id used for both analysis and project chat.
GEMINI_MODEL=gemini-2.5-flash

# Persistence. Local dev uses .data/store.json and needs nothing here.
# On Vercel, add the Upstash Redis integration (Storage tab). It sets these
# variables (or the KV_REST_API_URL / KV_REST_API_TOKEN equivalents) for you.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
